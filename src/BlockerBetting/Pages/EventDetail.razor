@page "/events/{Id:guid}"
@inject BettingService Betting
@inject ISnackbar Snackbar

<PageTitle>@(_event?.Event.Title ?? "Wette") · BlockerBetting</PageTitle>

<MudButton Href="" StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Text" Class="mb-2">Alle Wetten</MudButton>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_event is null)
{
    <MudAlert Severity="Severity.Warning">Wette nicht gefunden.</MudAlert>
}
else
{
    var ev = _event;
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4">@ev.Event.Title</MudText>
            <MudSpacer />
            @if (Betting.CurrentProfile?.IsAdmin == true && ev.Event.Status is EventStatus.Open or EventStatus.Locked)
            {
                <MudButton Href="@($"admin/bets/{ev.Event.Id}")" StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small" Variant="Variant.Text">Bearbeiten</MudButton>
            }
            <EventStatusChip Event="ev.Event" />
        </MudStack>
        @if (!string.IsNullOrWhiteSpace(ev.Event.Description))
        {
            <MudText Class="mt-2" Style="white-space:pre-line">@ev.Event.Description</MudText>
        }
        <MudText Typo="Typo.caption" Class="mt-2 d-block">
            @ev.TotalBets Wetten · @ev.TotalStake.ToString("N0") Coins gesetzt
            @if (ev.Event.ClosesAt is { } closes) { <span> · Wettschluss: @closes.ToLocalTime().ToString("g")</span> }
        </MudText>
    </MudPaper>

    <MudGrid>
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" GutterBottom="true">Optionen & Quoten</MudText>
                <MudRadioGroup T="Guid?" @bind-Value="_selectedOption" Disabled="!ev.Event.AcceptsBets">
                    @foreach (var option in ev.Options)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="py-1">
                            <MudRadio T="Guid?" Value="@option.Id" Color="Color.Primary">
                                @(ev.Event.WinningOptionId == option.Id ? "🏆 " : "")@option.Label
                            </MudRadio>
                            <MudSpacer />
                            <MudText Typo="Typo.caption" Class="mr-2">@ev.BetsFor(option.Id) Wetten</MudText>
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@option.Odds.ToString("0.00")</MudChip>
                        </MudStack>
                    }
                </MudRadioGroup>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" GutterBottom="true">Wette platzieren</MudText>
                @if (!ev.Event.AcceptsBets)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">Für diese Wette werden keine Einsätze mehr angenommen.</MudAlert>
                }
                else
                {
                    <MudNumericField T="long" @bind-Value="_amount" Label="Einsatz (Coins)" Min="1" Max="@(Betting.CurrentProfile?.Coins ?? 0)" Variant="Variant.Outlined" />
                    <MudStack Row="true" Class="my-2" Wrap="Wrap.Wrap" Spacing="1">
                        @foreach (var quick in new long[] { 10, 50, 100, 250 })
                        {
                            <MudChip T="string" Size="Size.Small" OnClick="@(() => _amount = quick)">@quick</MudChip>
                        }
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => _amount = Betting.CurrentProfile?.Coins ?? 0)">All-in</MudChip>
                    </MudStack>
                    @if (SelectedOption is { } sel && _amount > 0)
                    {
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Möglicher Gewinn: <b>@Payouts.For(_amount, sel.Odds).ToString("N0") Coins</b> (Quote @sel.Odds.ToString("0.00"))
                        </MudText>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               Disabled="@(_busy || _selectedOption is null || _amount <= 0)" OnClick="PlaceBet">
                        Wette platzieren
                    </MudButton>
                }

                @if (_myBets.Count > 0)
                {
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle1">Deine Wetten</MudText>
                    <MudList T="string" Dense="true">
                        @foreach (var bet in _myBets)
                        {
                            <MudListItem T="string">
                                @bet.Amount.ToString("N0") auf <b>@OptionLabel(bet.OptionId)</b> @@ @bet.Odds.ToString("0.00")
                                @if (bet.Payout is { } payout)
                                {
                                    <span> → @payout.ToString("N0") ausgezahlt</span>
                                }
                                else
                                {
                                    <span> → möglich @bet.PotentialPayout.ToString("N0")</span>
                                }
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private EventOverview? _event;
    private List<Bet> _myBets = [];
    private bool _loading = true;
    private bool _busy;
    private Guid? _selectedOption;
    private long _amount = 50;

    private EventOption? SelectedOption => _event?.Options.FirstOrDefault(o => o.Id == _selectedOption);

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        await Load();
        _loading = false;
    }

    private async Task Load()
    {
        try
        {
            _event = await Betting.GetEventAsync(Id);
            _myBets = await Betting.GetMyBetsAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
    }

    private string OptionLabel(Guid optionId) =>
        _event?.Options.FirstOrDefault(o => o.Id == optionId)?.Label ?? "?";

    private async Task PlaceBet()
    {
        _busy = true;
        try
        {
            await Betting.PlaceBetAsync(_selectedOption!.Value, _amount);
            Snackbar.Add($"{_amount:N0} Coins auf „{OptionLabel(_selectedOption.Value)}“ gesetzt.", Severity.Success);
            await Load();
        }
        catch (Exception ex)
        {
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
