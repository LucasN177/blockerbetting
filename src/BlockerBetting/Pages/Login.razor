@page "/login"
@attribute [AllowAnonymous]
@inject BettingService Betting
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject ThemeService ThemeService
@layout AuthLayout
@implements IDisposable

<PageTitle>Anmelden · BlockerBetting</PageTitle>

<div class="bb-auth">
    <section class="bb-auth-hero">
        <div class="bb-brand" style="position:relative; z-index:1">
            <img src="favicon.svg" alt="" />
            <span class="bb-brand-name">BlockerBetting</span>
        </div>

        <div style="position:relative; z-index:1">
            <h1 class="bb-auth-headline">Tippe mit. Gewinne Coins. Hol dir Platz 1.</h1>
            <div style="opacity:0.8; max-width:42ch">Die interne Wettplattform fürs Team – gespielt wird ausschließlich mit virtuellen Coins.</div>
            <div class="bb-auth-hero-features mt-6">
                <div class="bb-auth-feature"><MudIcon Icon="@Icons.Material.Rounded.Toll" /> 1.000 Start-Coins für jeden</div>
                <div class="bb-auth-feature"><MudIcon Icon="@Icons.Material.Rounded.TrendingUp" /> Feste Quoten, transparent berechnet</div>
                <div class="bb-auth-feature"><MudIcon Icon="@Icons.Material.Rounded.EmojiEvents" /> Live-Rangliste aller Spieler</div>
            </div>
        </div>

        <div class="bb-auth-hero-features" style="position:relative; z-index:1; font-size:0.8rem; opacity:0.6">
            v@(AppInfo.Version) · by @AppInfo.Author
        </div>
    </section>

    <section class="bb-auth-form-wrap">
        <div class="bb-auth-form">
            <div class="d-flex justify-end mb-6">
                <MudIconButton Icon="@(ThemeService.IsDarkMode ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode)"
                               OnClick="ThemeService.Toggle" aria-label="Design wechseln" />
            </div>

            <MudText Typo="Typo.h4">@(_tab == 0 ? "Willkommen zurück" : "Account erstellen")</MudText>
            <MudText Class="bb-muted mt-1 mb-6">
                @(_tab == 0 ? "Melde dich an, um weiterzuwetten." : "In wenigen Sekunden startklar – mit 1.000 Coins.")
            </MudText>

            <MudToggleGroup T="int" @bind-Value="_tab" Outlined="false" Delimiters="false" Class="bb-segment mb-6" SelectedClass="bb-segment-selected" Style="width:100%" CheckMark="false">
                <MudToggleItem Value="0" Text="Anmelden" />
                <MudToggleItem Value="1" Text="Registrieren" />
            </MudToggleGroup>

            @if (_tab == 0)
            {
                    <MudForm @ref="_loginForm">
                        <MudTextField @bind-Value="_email" Label="E-Mail" InputType="InputType.Email" Required="true" RequiredError="E-Mail fehlt" Immediate="true"
                                      OnKeyDown="@(e => OnEnter(e, SignIn))" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Email" Class="mb-4" />
                        <MudTextField @bind-Value="_password" Immediate="true" Label="Passwort" InputType="@(_showPassword ? InputType.Text : InputType.Password)" Required="true" RequiredError="Passwort fehlt"
                                      OnKeyDown="@(e => OnEnter(e, SignIn))" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                      OnAdornmentClick="@(() => _showPassword = !_showPassword)" AdornmentAriaLabel="Passwort anzeigen" Class="mb-6" />
                        <MudButton Variant="Variant.Filled" FullWidth="true" Disabled="_busy" Class="bb-cta" OnClick="SignIn">
                            @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Style="color:inherit" /> }
                            Anmelden
                        </MudButton>
                    </MudForm>
            }
            else
            {
                    <MudForm @ref="_registerForm">
                        <MudTextField @bind-Value="_displayName" Immediate="true" Label="Anzeigename" Required="true" RequiredError="Anzeigename fehlt" MaxLength="40"
                                      OnKeyDown="@(e => OnEnter(e, SignUp))" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Badge" Class="mb-4" />
                        <MudTextField @bind-Value="_email" Label="E-Mail" InputType="InputType.Email" Required="true" RequiredError="E-Mail fehlt" Immediate="true"
                                      OnKeyDown="@(e => OnEnter(e, SignUp))" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Email" Class="mb-4" />
                        <MudTextField @bind-Value="_password" Immediate="true" Label="Passwort" HelperText="Mindestens 6 Zeichen" InputType="@(_showPassword ? InputType.Text : InputType.Password)" Required="true"
                                      Validation="@(new Func<string, string?>(ValidatePassword))"
                                      OnKeyDown="@(e => OnEnter(e, SignUp))" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                      OnAdornmentClick="@(() => _showPassword = !_showPassword)" AdornmentAriaLabel="Passwort anzeigen" Class="mb-6" />
                        <MudButton Variant="Variant.Filled" FullWidth="true" Disabled="_busy" Class="bb-cta" OnClick="SignUp">
                            @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Style="color:inherit" /> }
                            Account erstellen
                        </MudButton>
                    </MudForm>
            }

            <div class="bb-auth-footer">v@(AppInfo.Version) · by @AppInfo.Author</div>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private MudForm? _loginForm;
    private MudForm? _registerForm;
    private int _tab;
    private bool _busy;
    private string _email = "";
    private string _password = "";
    private string _displayName = "";

    protected override void OnInitialized()
    {
        if (Betting.CurrentUserId is not null) Done();
    }

    // Enter in any field submits (MudForm does not forward a native form submit).
    private async Task OnEnter(KeyboardEventArgs e, Func<Task> submit)
    {
        if (e.Key is "Enter" or "NumpadEnter" && !_busy) await submit();
    }

    private static string? ValidatePassword(string? password) =>
        password?.Length >= 6 ? null : "Mindestens 6 Zeichen";

    private async Task SignIn()
    {
        await _loginForm!.ValidateAsync();
        if (!_loginForm.IsValid) return;
        await Run(async () =>
        {
            await Betting.SignInAsync(_email.Trim(), _password);
            Done();
        });
    }

    private async Task SignUp()
    {
        await _registerForm!.ValidateAsync();
        if (!_registerForm.IsValid) return;
        await Run(async () =>
        {
            if (await Betting.SignUpAsync(_email.Trim(), _password, _displayName.Trim()))
            {
                Snackbar.Add("Willkommen! Du startest mit 1.000 Coins.", Severity.Success);
                Done();
            }
            else
            {
                Snackbar.Add("Fast geschafft – bitte bestätige deine E-Mail-Adresse und melde dich dann an.", Severity.Info);
                _tab = 0;
            }
        });
    }

    private async Task Run(Func<Task> action)
    {
        _busy = true;
        try { await action(); }
        catch (Exception ex) { Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error); }
        finally { _busy = false; }
    }

    private void Done()
    {
        var safe = !string.IsNullOrEmpty(ReturnUrl) && !ReturnUrl.StartsWith("login") && !ReturnUrl.Contains(':') && !ReturnUrl.StartsWith("/");
        Nav.NavigateTo(safe ? ReturnUrl! : "", replace: true);
    }

    private bool _showPassword;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) ThemeService.Changed += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeService.Changed -= Refresh;
}
