@page "/login"
@attribute [AllowAnonymous]
@inject BettingService Betting
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Anmelden · BlockerBetting</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-8">
    <MudItem xs="12" sm="8" md="5">
        <MudPaper Elevation="3" Class="pa-6">
            <div style="text-align:center"><img src="favicon.svg" alt="" width="72" height="72" style="border-radius:18px" /></div>
            <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">BlockerBetting</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-4">Interne Wettplattform – nur virtuelle Coins.</MudText>

            <MudTabs @bind-ActivePanelIndex="_tab" Centered="true" Elevation="0">
                <MudTabPanel Text="Anmelden">
                    <MudForm @ref="_loginForm" Class="mt-4">
                        <MudTextField @bind-Value="_email" Label="E-Mail" InputType="InputType.Email" Required="true" Variant="Variant.Outlined" Class="mb-3" />
                        <MudTextField @bind-Value="_password" Label="Passwort" InputType="InputType.Password" Required="true" Variant="Variant.Outlined" Class="mb-4" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="_busy" OnClick="SignIn">Anmelden</MudButton>
                    </MudForm>
                </MudTabPanel>
                <MudTabPanel Text="Registrieren">
                    <MudForm @ref="_registerForm" Class="mt-4">
                        <MudTextField @bind-Value="_displayName" Label="Anzeigename" Required="true" MaxLength="40" Variant="Variant.Outlined" Class="mb-3" />
                        <MudTextField @bind-Value="_email" Label="E-Mail" InputType="InputType.Email" Required="true" Variant="Variant.Outlined" Class="mb-3" />
                        <MudTextField @bind-Value="_password" Label="Passwort (min. 6 Zeichen)" InputType="InputType.Password" Required="true" Variant="Variant.Outlined" Class="mb-4"
                                      Validation="@(new Func<string, string?>(ValidatePassword))" />
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" Disabled="_busy" OnClick="SignUp">Account erstellen</MudButton>
                    </MudForm>
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private MudForm? _loginForm;
    private MudForm? _registerForm;
    private int _tab;
    private bool _busy;
    private string _email = "";
    private string _password = "";
    private string _displayName = "";

    protected override void OnInitialized()
    {
        if (Betting.CurrentUserId is not null) Done();
    }

    private static string? ValidatePassword(string? password) =>
        password?.Length >= 6 ? null : "Mindestens 6 Zeichen";

    private async Task SignIn()
    {
        await _loginForm!.ValidateAsync();
        if (!_loginForm.IsValid) return;
        await Run(async () =>
        {
            await Betting.SignInAsync(_email.Trim(), _password);
            Done();
        });
    }

    private async Task SignUp()
    {
        await _registerForm!.ValidateAsync();
        if (!_registerForm.IsValid) return;
        await Run(async () =>
        {
            if (await Betting.SignUpAsync(_email.Trim(), _password, _displayName.Trim()))
            {
                Snackbar.Add("Willkommen! Du startest mit 1.000 Coins.", Severity.Success);
                Done();
            }
            else
            {
                Snackbar.Add("Fast geschafft – bitte bestätige deine E-Mail-Adresse und melde dich dann an.", Severity.Info);
                _tab = 0;
            }
        });
    }

    private async Task Run(Func<Task> action)
    {
        _busy = true;
        try { await action(); }
        catch (Exception ex) { Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error); }
        finally { _busy = false; }
    }

    private void Done()
    {
        var safe = !string.IsNullOrEmpty(ReturnUrl) && !ReturnUrl.StartsWith("login") && !ReturnUrl.Contains(':') && !ReturnUrl.StartsWith("/");
        Nav.NavigateTo(safe ? ReturnUrl! : "", replace: true);
    }
}
