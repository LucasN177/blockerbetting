@page "/"
@inject BettingService Betting
@inject ISnackbar Snackbar

<PageTitle>Events · BlockerBetting</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Events</MudText>
    <MudSpacer />
    <MudSwitch @bind-Value="_showClosed" Color="Color.Primary" Label="Abgeschlossene anzeigen" />
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Load" aria-label="Aktualisieren" />
</MudStack>

@if (_events is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!Visible.Any())
{
    <MudAlert Severity="Severity.Info">Aktuell gibt es keine Events.</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var ev in Visible)
        {
            <MudItem xs="12" md="6" lg="4">
                <MudCard Elevation="2" Style="height:100%">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@ev.Event.Title</MudText>
                            @if (ev.Event.ClosesAt is { } closes)
                            {
                                <MudText Typo="Typo.caption">Wettschluss: @closes.ToLocalTime().ToString("g")</MudText>
                            }
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <EventStatusChip Event="ev.Event" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        @foreach (var option in ev.Options)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-1">
                                <MudText Typo="Typo.body2">@(ev.Event.WinningOptionId == option.Id ? "🏆 " : "")@option.Label</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@option.Odds.ToString("0.00")</MudChip>
                            </MudStack>
                        }
                        <MudText Typo="Typo.caption" Class="mt-3 d-block">@ev.TotalBets Wetten · @ev.TotalStake.ToString("N0") Coins gesetzt</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Href="@($"events/{ev.Event.Id}")" Variant="Variant.Text" Color="Color.Primary">
                            @(ev.Event.AcceptsBets ? "Wetten" : "Details")
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<EventOverview>? _events;
    private bool _showClosed;

    private IEnumerable<EventOverview> Visible => (_events ?? [])
        .Where(e => _showClosed || e.Event.Status is EventStatus.Open or EventStatus.Locked)
        .OrderByDescending(e => e.Event.AcceptsBets)
        .ThenBy(e => e.Event.ClosesAt ?? DateTime.MaxValue);

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try { _events = await Betting.GetEventsAsync(); }
        catch (Exception ex)
        {
            _events = [];
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
    }
}
