@page "/"
@inject BettingService Betting
@inject ISnackbar Snackbar

<PageTitle>Wetten · BlockerBetting</PageTitle>

<section class="bb-hero">
    <div style="position:relative; z-index:1">
        <div class="bb-hero-stat-label" style="opacity:0.75">@Fmt.Greeting()</div>
        <h1 class="bb-hero-title">@(Betting.CurrentProfile?.DisplayName ?? "Willkommen")</h1>
        <div class="bb-hero-sub">Wähle eine Wette, setze deine Coins und klettere in der Rangliste nach oben.</div>
    </div>
    <div class="bb-hero-stats">
        <div>
            <div class="bb-hero-stat-label">Guthaben</div>
            <div class="bb-hero-stat-value"><span class="bb-coin"></span>@Fmt.Coins(Betting.CurrentProfile?.Coins ?? 0)</div>
        </div>
        <div>
            <div class="bb-hero-stat-label">Offene Tipps</div>
            <div class="bb-hero-stat-value">@_openBets.Count</div>
        </div>
        <div>
            <div class="bb-hero-stat-label">Möglicher Gewinn</div>
            <div class="bb-hero-stat-value"><span class="bb-coin"></span>@Fmt.Coins(_openBets.Sum(b => b.PotentialPayout))</div>
        </div>
    </div>
</section>

@foreach (var mine in ToDecide)
{
    <a href="@($"events/{mine.Event.Id}")" class="bb-card bb-hover d-flex align-center gap-3 pa-4 mb-4" style="text-decoration:none; color:inherit; border-color:rgba(var(--mud-palette-success-rgb),0.45)">
        <div class="bb-stat-icon bb-tint-success"><MudIcon Icon="@Icons.Material.Rounded.Gavel" /></div>
        <div class="bb-grow">
            <div style="font-weight:700">Deine Wette wartet auf ein Ergebnis</div>
            <div class="bb-muted bb-ellipsis" style="font-size:0.85rem">„@mine.Event.Title“ ist abgelaufen – lege jetzt fest, wer gewonnen hat.</div>
        </div>
        <MudIcon Icon="@Icons.Material.Rounded.ChevronRight" />
    </a>
}

<PageHeader Title="Wetten" Eyebrow="Wettangebot">
    <Actions>
        <MudToggleGroup T="string" @bind-Value="_filter" Size="Size.Small" Outlined="false" Delimiters="false" Class="bb-segment" SelectedClass="bb-segment-selected" CheckMark="false">
            <MudToggleItem Value="@("live")" Text="Aktiv" />
            <MudToggleItem Value="@("done")" Text="Entschieden" />
            <MudToggleItem Value="@("all")" Text="Alle" />
        </MudToggleGroup>
        <MudTooltip Text="Aktualisieren">
            <MudIconButton Icon="@Icons.Material.Rounded.Refresh" OnClick="Load" />
        </MudTooltip>
    </Actions>
</PageHeader>

@if (_events is null)
{
    <MudGrid Spacing="3">
        @for (var i = 0; i < 3; i++)
        {
            <MudItem xs="12" sm="6" lg="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="230px" Style="border-radius:20px" />
            </MudItem>
        }
    </MudGrid>
}
else if (!Visible.Any())
{
    <div class="bb-card bb-card-pad d-flex flex-column align-center" style="padding:3.5rem 1.5rem; text-align:center">
        <div class="bb-stat-icon bb-tint-primary mb-4" style="width:64px;height:64px;border-radius:18px">
            <MudIcon Icon="@Icons.Material.Rounded.SportsScore" Size="Size.Large" />
        </div>
        <MudText Typo="Typo.h6">Gerade keine Wetten</MudText>
        <MudText Class="bb-muted mt-1">
            @(_filter == "live" ? "Sobald ein Admin eine neue Wette anlegt, erscheint sie hier." : "Hier gibt es noch nichts zu sehen.")
        </MudText>
        @if (Betting.CurrentProfile?.IsAdmin == true)
        {
            <MudButton Href="admin/bets/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" Class="mt-5">Neue Wette anlegen</MudButton>
        }
    </div>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var ev in Visible)
        {
            <MudItem xs="12" sm="6" lg="4">
                <EventCard Item="ev" />
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<EventOverview>? _events;
    private List<Bet> _openBets = [];

    /// <summary>Bets created by the current user whose deadline has passed and which still need a result.</summary>
    private IEnumerable<EventOverview> ToDecide => (_events ?? [])
        .Where(e => Betting.IsCreator(e.Event) && Betting.CanResolve(e.Event)
                    && e.Event.ClosesAt is { } closes && closes <= DateTime.UtcNow);
    private string _filter = "live";

    private IEnumerable<EventOverview> Visible => (_events ?? [])
        .Where(e => _filter switch
        {
            "live" => e.Event.Status is EventStatus.Open or EventStatus.Locked,
            "done" => e.Event.Status is EventStatus.Resolved or EventStatus.Cancelled,
            _ => true,
        })
        .OrderByDescending(e => e.Event.AcceptsBets)
        .ThenBy(e => e.Event.ClosesAt ?? DateTime.MaxValue);

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try
        {
            _events = await Betting.GetEventsAsync();
            _openBets = (await Betting.GetMyBetsAsync()).Where(b => b.Payout is null).ToList();
        }
        catch (Exception ex)
        {
            _events = [];
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
    }
}
