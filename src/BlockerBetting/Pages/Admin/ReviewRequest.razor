@page "/admin/requests/{Id:guid}"
@inject BettingService Betting
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Anfrage prüfen · BlockerBetting</PageTitle>

<MudButton Href="admin/requests" StartIcon="@Icons.Material.Rounded.ArrowBack" Variant="Variant.Text" Color="Color.Default" Size="Size.Small" Class="mb-4">Alle Anfragen</MudButton>
<PageHeader Title="Anfrage prüfen" Eyebrow="Admin"
            Subtitle="Passe Titel, Wettschluss, Optionen und Quoten bei Bedarf an und schalte die Wette frei." />

@if (Betting.CurrentProfile?.IsAdmin != true)
{
    <MudAlert Severity="Severity.Warning">Nur Admins können Anfragen bearbeiten.</MudAlert>
}
else if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_request is null)
{
    <MudAlert Severity="Severity.Info">Anfrage nicht gefunden.</MudAlert>
}
else if (_request.Status != RequestStatus.Pending)
{
    var (label, css) = Fmt.Status(_request);
    <div class="bb-card bb-card-pad">
        <span class="bb-pill @css">@label</span>
        <MudText Class="mt-3">Diese Anfrage wurde bereits bearbeitet.</MudText>
        @if (_request.EventId is { } eventId)
        {
            <MudButton Href="@($"events/{eventId}")" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-4">Zur Wette</MudButton>
        }
    </div>
}
else
{
    <MudGrid Spacing="4">
        <MudItem xs="12" lg="8">
            <div class="bb-card bb-card-pad">
                <BetForm Draft="_draft!" RequireDeadline="true" Busy="_busy" CancelHref="admin/requests"
                         SubmitText="Genehmigen & veröffentlichen" SubmitIcon="@Icons.Material.Rounded.Check" OnSubmit="Approve">
                    <ExtraActions>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy" OnClick="Reject"
                                   StartIcon="@Icons.Material.Rounded.Block">Ablehnen</MudButton>
                    </ExtraActions>
                </BetForm>
            </div>
        </MudItem>
        <MudItem xs="12" lg="4">
            <div class="bb-card bb-card-pad">
                <div class="bb-section-title">Antragsteller</div>
                <div class="d-flex align-center gap-3">
                    <Avatar Name="@_requester" Size="44" />
                    <div>
                        <div style="font-weight:700">@_requester</div>
                        <div class="bb-muted" style="font-size:0.8rem">eingereicht am @Fmt.Date(_request.CreatedAt)</div>
                    </div>
                </div>
                <MudDivider Class="my-4" />
                <div class="d-flex align-start gap-3" style="font-size:0.85rem">
                    <MudIcon Icon="@Icons.Material.Rounded.Gavel" Color="Color.Primary" Size="Size.Small" />
                    <div>Nach der Freigabe ist <b>@_requester</b> Ersteller der Wette und darf sie nach dem Wettschluss selbst auflösen und auszahlen. Admins können das jederzeit.</div>
                </div>
            </div>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private BetRequest? _request;
    private BetDraft? _draft;
    private string _requester = "";
    private bool _loading = true;
    private bool _busy;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _request = await Betting.GetBetRequestAsync(Id);
            if (_request is not null)
            {
                _draft = BetDraft.From(_request);
                var names = await Betting.GetDisplayNamesAsync();
                _requester = names.GetValueOrDefault(_request.RequestedBy, "Unbekannt");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
        _loading = false;
    }

    private async Task Approve(BetDraft draft)
    {
        _busy = true;
        try
        {
            var eventId = await Betting.ApproveBetRequestAsync(Id, draft.Title.Trim(), draft.Description, draft.ClosesAtUtc!.Value, draft.ToOptionInputs());
            Snackbar.Add("Anfrage genehmigt – die Wette ist jetzt online.", Severity.Success);
            Nav.NavigateTo($"events/{eventId}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Reject()
    {
        var dialog = await Dialogs.ShowAsync<RejectDialog>($"„{_request!.Title}“ ablehnen");
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: string note }) return;

        _busy = true;
        try
        {
            await Betting.RejectBetRequestAsync(Id, note);
            Snackbar.Add("Anfrage abgelehnt.", Severity.Info);
            Nav.NavigateTo("admin/requests");
        }
        catch (Exception ex)
        {
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
