@page "/admin/bets/new"
@page "/admin/bets/{Id:guid}"
@inject BettingService Betting
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(IsNew ? "Neue Wette" : "Wette bearbeiten") · BlockerBetting</PageTitle>

<MudButton Href="admin/bets" StartIcon="@Icons.Material.Rounded.ArrowBack" Variant="Variant.Text" Color="Color.Default" Size="Size.Small" Class="mb-4">Wetten verwalten</MudButton>
<PageHeader Title="@(IsNew ? "Neue Wette" : "Wette bearbeiten")" Eyebrow="Admin"
            Subtitle="Auszahlung bei Gewinn = Einsatz × Quote. Quotenänderungen gelten nur für neue Tipps." />

@if (Betting.CurrentProfile?.IsAdmin != true)
{
    <MudAlert Severity="Severity.Warning">Nur Admins können Wetten verwalten.</MudAlert>
}
else if (_draft is null && _readOnlyReason is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_readOnlyReason is not null)
{
    <MudAlert Severity="Severity.Info">@_readOnlyReason</MudAlert>
}
else
{
    <div class="bb-card bb-card-pad" style="max-width:56rem">
        @if (_copiedFrom is not null)
        {
            <div class="d-flex align-center gap-3 mb-6 pa-4" style="border-radius:14px; background:rgba(var(--mud-palette-warning-rgb),0.12)">
                <MudIcon Icon="@Icons.Material.Rounded.ContentCopy" Color="Color.Warning" />
                <div class="bb-grow" style="font-size:0.88rem">
                    Kopie von <b>„@_copiedFrom“</b>. Alle Felder sind anpassbar – die ursprüngliche Wette bleibt unverändert.
                    @if (_deadlineCleared) { <span> Der alte Wettschluss war abgelaufen, bitte einen neuen wählen.</span> }
                </div>
            </div>
        }
        <BetForm @key="_formKey" Draft="_draft!" DeadlineInFuture="IsNew" CancelHref="admin/bets" Busy="_busy"
                 SubmitText="@(IsNew ? "Wette anlegen" : "Speichern")" OnSubmit="Save" />
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    /// <summary>Existing bet to copy into the "new bet" form (<c>admin/bets/new?copy={id}</c>).</summary>
    [SupplyParameterFromQuery(Name = "copy")] public Guid? CopyId { get; set; }

    private bool IsNew => Id is null;

    private BetDraft? _draft;
    private bool _busy;
    private string? _readOnlyReason;
    private string? _copiedFrom;
    private bool _deadlineCleared;
    private int _formKey;

    protected override async Task OnParametersSetAsync()
    {
        _draft = null;
        _readOnlyReason = null;
        _copiedFrom = null;
        _deadlineCleared = false;
        _formKey++;
        if (IsNew && CopyId is null)
        {
            _draft = BetDraft.NewYesNo();
            return;
        }
        if (IsNew)
        {
            try
            {
                var source = await Betting.GetEventAsync(CopyId!.Value);
                if (source is null)
                {
                    _draft = BetDraft.NewYesNo();
                    Snackbar.Add("Die zu kopierende Wette wurde nicht gefunden.", Severity.Warning);
                }
                else
                {
                    _draft = BetDraft.CopyOf(source, out _deadlineCleared);
                    _copiedFrom = source.Event.Title;
                }
            }
            catch (Exception ex)
            {
                _draft = BetDraft.NewYesNo();
                Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
            }
            return;
        }

        try
        {
            var ev = await Betting.GetEventAsync(Id!.Value);
            if (ev is null)
                _readOnlyReason = "Wette nicht gefunden.";
            else if (ev.Event.Status is not (EventStatus.Open or EventStatus.Locked))
                _readOnlyReason = "Abgeschlossene Wetten können nicht mehr bearbeitet werden.";
            else
                _draft = BetDraft.From(ev);
        }
        catch (Exception ex)
        {
            _readOnlyReason = BettingService.ErrorMessage(ex);
        }
    }

    private async Task Save(BetDraft draft)
    {
        _busy = true;
        try
        {
            if (IsNew)
            {
                await Betting.CreateEventAsync(draft.Title.Trim(), draft.Description, draft.ClosesAtUtc, draft.ToOptionInputs());
                Snackbar.Add("Wette angelegt.", Severity.Success);
            }
            else
            {
                await Betting.UpdateEventAsync(Id!.Value, draft.Title.Trim(), draft.Description, draft.ClosesAtUtc, draft.ToOptionInputs());
                Snackbar.Add("Änderungen gespeichert.", Severity.Success);
            }
            Nav.NavigateTo("admin/bets");
        }
        catch (Exception ex)
        {
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
