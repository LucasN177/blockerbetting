@page "/leaderboard"
@inject BettingService Betting
@inject ISnackbar Snackbar

<PageTitle>Rangliste · BlockerBetting</PageTitle>

<PageHeader Title="Rangliste" Eyebrow="Wer hat die meisten Coins?" />

@if (_profiles is null)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="420px" Style="border-radius:20px" />
}
else if (_profiles.Count == 0)
{
    <div class="bb-card bb-card-pad bb-muted">Noch keine Spieler.</div>
}
else
{
    var top = _profiles.Take(3).ToList();
    var max = Math.Max(1, _profiles[0].Coins);

    <div class="bb-podium">
        @foreach (var index in new[] { 1, 0, 2 })
        {
            @if (index < top.Count)
            {
                var p = top[index];
                <div class="bb-card bb-podium-place @(index == 0 ? "bb-podium-1" : "")">
                    <div class="bb-medal">@(index switch { 0 => "🥇", 1 => "🥈", _ => "🥉" })</div>
                    <Avatar Name="@p.DisplayName" Size="@(index == 0 ? 64 : 52)" />
                    <div style="font-weight:700; max-width:100%" class="bb-ellipsis">@p.DisplayName</div>
                    <Coins Value="p.Coins" />
                </div>
            }
            else
            {
                <div></div>
            }
        }
    </div>

    <div class="bb-card">
        @for (var i = 0; i < _profiles.Count; i++)
        {
            var p = _profiles[i];
            var me = p.Id == Betting.CurrentUserId;
            <div class="bb-list-row @(me ? "bb-me" : "")">
                <div class="bb-rank">@(i + 1)</div>
                <Avatar Name="@p.DisplayName" Size="36" />
                <div class="bb-grow">
                    <div style="font-weight:600" class="bb-ellipsis">
                        @p.DisplayName
                        @if (me) { <span class="bb-pill bb-tint-primary ml-1" style="padding:1px 8px">Du</span> }
                    </div>
                    <MudProgressLinear Value="@(100.0 * p.Coins / max)" Color="Color.Primary" Rounded="true" Size="Size.Small" Class="mt-1" Style="max-width:260px; opacity:0.7" />
                </div>
                <Coins Value="p.Coins" />
            </div>
        }
    </div>
}

@code {
    private List<Profile>? _profiles;

    protected override async Task OnInitializedAsync()
    {
        try { _profiles = await Betting.GetLeaderboardAsync(); }
        catch (Exception ex)
        {
            _profiles = [];
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
    }
}
