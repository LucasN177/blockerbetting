@page "/requests"
@inject BettingService Betting
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Wette vorschlagen · BlockerBetting</PageTitle>

<PageHeader Title="Wette vorschlagen" Eyebrow="Deine Idee"
            Subtitle="Schlag eine Wette vor – ein Admin prüft sie, passt sie ggf. an und schaltet sie frei." />

<MudGrid Spacing="4">
    <MudItem xs="12" lg="7">
        <div class="bb-card bb-card-pad">
            <div class="d-flex align-start gap-3 mb-6 pa-4" style="border-radius:14px; background:rgba(var(--mud-palette-primary-rgb),0.07)">
                <MudIcon Icon="@Icons.Material.Rounded.Gavel" Color="Color.Primary" />
                <div style="font-size:0.88rem">
                    <b>Du entscheidest mit.</b> Wird dein Vorschlag genehmigt, bist du Ersteller der Wette und darfst
                    sie nach dem Wettschluss selbst auflösen und auszahlen.
                </div>
            </div>
            <BetForm @key="_formKey" Draft="_draft" RequireDeadline="true" OddsAreSuggestion="true" Busy="_busy"
                     OddsHint="Deine Quoten sind ein Vorschlag – der Admin kann sie vor der Freigabe anpassen."
                     SubmitText="Vorschlag einreichen" SubmitIcon="@Icons.Material.Rounded.Send" OnSubmit="Submit" />
        </div>
    </MudItem>

    <MudItem xs="12" lg="5">
        <div class="bb-section-title">Meine Vorschläge</div>
        @if (_requests is null)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Style="border-radius:20px" />
        }
        else if (_requests.Count == 0)
        {
            <div class="bb-card bb-card-pad bb-muted" style="text-align:center">
                Du hast noch keine Wette vorgeschlagen.
            </div>
        }
        else
        {
            <div class="bb-card">
                @foreach (var request in _requests)
                {
                    var (label, css) = Fmt.Status(request);
                    <div class="bb-list-row" style="align-items:flex-start">
                        <div class="bb-grow">
                            <div class="d-flex align-center gap-2 mb-1">
                                <span class="bb-pill @css">@label</span>
                                <span class="bb-muted" style="font-size:0.75rem">@Fmt.ShortDate(request.CreatedAt)</span>
                            </div>
                            <div style="font-weight:600">@request.Title</div>
                            <div class="bb-muted" style="font-size:0.8rem">
                                @string.Join(" · ", request.Options.Select(o => $"{o.Label} {Fmt.Odds(o.Odds)}"))
                            </div>
                            @if (request.Status == RequestStatus.Rejected && !string.IsNullOrWhiteSpace(request.AdminNote))
                            {
                                <div class="mt-2 pa-2" style="font-size:0.8rem; border-radius:10px; background:rgba(var(--mud-palette-error-rgb),0.08)">
                                    <b>Begründung:</b> @request.AdminNote
                                </div>
                            }
                        </div>
                        <div class="d-flex flex-column align-end gap-1">
                            @if (request.Status == RequestStatus.Approved && request.EventId is { } eventId)
                            {
                                <MudButton Href="@($"events/{eventId}")" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">Zur Wette</MudButton>
                            }
                            @if (request.Status == RequestStatus.Pending)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Disabled="_busy"
                                           OnClick="@(() => Withdraw(request))">Zurückziehen</MudButton>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </MudItem>
</MudGrid>

@code {
    private BetDraft _draft = BetDraft.NewYesNo();
    private int _formKey;
    private List<BetRequest>? _requests;
    private bool _busy;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try { _requests = await Betting.GetMyBetRequestsAsync(); }
        catch (Exception ex)
        {
            _requests = [];
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
    }

    private async Task Submit(BetDraft draft)
    {
        _busy = true;
        try
        {
            await Betting.SubmitBetRequestAsync(draft.Title.Trim(), draft.Description, draft.ClosesAtUtc!.Value, draft.ToOptionInputs());
            Snackbar.Add("Danke! Dein Vorschlag wurde eingereicht und wird von einem Admin geprüft.", Severity.Success);
            _draft = BetDraft.NewYesNo();
            _formKey++;
            await Load();
        }
        catch (Exception ex)
        {
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Withdraw(BetRequest request)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Vorschlag zurückziehen", $"„{request.Title}“ zurückziehen?",
            yesText: "Zurückziehen", cancelText: "Abbrechen");
        if (confirmed != true) return;
        _busy = true;
        try
        {
            await Betting.WithdrawBetRequestAsync(request.Id);
            await Load();
        }
        catch (Exception ex)
        {
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
