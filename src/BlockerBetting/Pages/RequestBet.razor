@page "/requests"
@inject BettingService Betting
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IJSRuntime Js

<PageTitle>Wette vorschlagen · BlockerBetting</PageTitle>

<PageHeader Title="Wette vorschlagen" Eyebrow="Deine Idee"
            Subtitle="Schlag eine Wette vor – ein Admin prüft sie, passt sie ggf. an und schaltet sie frei." />

<MudGrid Spacing="4">
    <MudItem xs="12" lg="7">
        <div class="bb-card bb-card-pad">
            <div class="d-flex align-start gap-3 mb-6 pa-4" style="border-radius:14px; background:rgba(var(--mud-palette-primary-rgb),0.07)">
                <MudIcon Icon="@Icons.Material.Rounded.Gavel" Color="Color.Primary" />
                <div style="font-size:0.88rem">
                    <b>Du entscheidest mit.</b> Wird dein Vorschlag genehmigt, bist du Ersteller der Wette und darfst
                    sie nach dem Wettschluss selbst auflösen und auszahlen.
                </div>
            </div>
            @if (_basedOn is not null || _copiedFrom is not null)
            {
                <div class="d-flex align-center gap-3 mb-6 pa-4" style="border-radius:14px; background:rgba(var(--mud-palette-warning-rgb),0.12)">
                    <MudIcon Icon="@(_copiedFrom is not null ? Icons.Material.Rounded.ContentCopy : Icons.Material.Rounded.EditNote)" Color="Color.Warning" />
                    <div class="bb-grow" style="font-size:0.88rem">
                        @if (_copiedFrom is not null)
                        {
                            <span>Kopie der Wette <b>„@_copiedFrom“</b>. Alle Felder sind anpassbar – die ursprüngliche Wette bleibt unverändert, deine Kopie wird als neuer Vorschlag geprüft.</span>
                        }
                        else
                        {
                            <span>Neue Anfrage auf Basis von <b>„@_basedOn!.Title“</b>. Alle Felder sind anpassbar – die alte Anfrage bleibt unverändert.</span>
                        }
                        @if (_deadlineCleared) { <span> Der alte Wettschluss war abgelaufen, bitte einen neuen wählen.</span> }
                    </div>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" OnClick="ResetForm">Verwerfen</MudButton>
                </div>
            }
            <BetForm @key="_formKey" Draft="_draft" RequireDeadline="true" OddsAreSuggestion="true" Busy="_busy"
                     OddsHint="Deine Quoten sind ein Vorschlag – der Admin kann sie vor der Freigabe anpassen."
                     SubmitText="Vorschlag einreichen" SubmitIcon="@Icons.Material.Rounded.Send" OnSubmit="Submit" />
        </div>
    </MudItem>

    <MudItem xs="12" lg="5">
        <PushSettings Compact="true" Class="mb-4" />
        <div class="bb-section-title">Meine Vorschläge</div>
        @if (_requests is null)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Style="border-radius:20px" />
        }
        else if (_requests.Count == 0)
        {
            <div class="bb-card bb-card-pad bb-muted" style="text-align:center">
                Du hast noch keine Wette vorgeschlagen.
            </div>
        }
        else
        {
            <div class="bb-card">
                @foreach (var request in _requests)
                {
                    var (label, css) = Fmt.Status(request);
                    var reusable = request.Status is RequestStatus.Rejected or RequestStatus.Withdrawn;
                    // Rejected requests are always shown in full, the others on demand.
                    var expanded = request.Status == RequestStatus.Rejected || _expanded.Contains(request.Id);
                    <div class="bb-list-row" style="align-items:flex-start; flex-direction:column; gap:0.5rem">
                        <div class="d-flex align-start gap-2" style="width:100%">
                            <div class="bb-grow">
                                <div class="d-flex align-center gap-2 mb-1">
                                    <span class="bb-pill @css">@label</span>
                                    <span class="bb-muted" style="font-size:0.75rem">@Fmt.ShortDate(request.CreatedAt)</span>
                                </div>
                                <div style="font-weight:600">@request.Title</div>
                                @if (!expanded)
                                {
                                    <div class="bb-muted" style="font-size:0.8rem">
                                        @string.Join(" · ", request.Options.Select(o => $"{o.Label} {Fmt.Odds(o.Odds)}"))
                                    </div>
                                }
                            </div>
                            @if (request.Status != RequestStatus.Rejected)
                            {
                                <MudIconButton Size="Size.Small" Icon="@(expanded ? Icons.Material.Rounded.ExpandLess : Icons.Material.Rounded.ExpandMore)"
                                               OnClick="@(() => ToggleExpanded(request.Id))" aria-label="Details" />
                            }
                        </div>

                        @if (expanded)
                        {
                            <div class="bb-request-details">
                                @if (!string.IsNullOrWhiteSpace(request.Description))
                                {
                                    <div style="white-space:pre-line">@request.Description</div>
                                }
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var option in request.Options)
                                    {
                                        <span class="bb-pill bb-pill-neutral" style="padding-left:10px">
                                            @option.Label <b style="color:var(--mud-palette-text-primary)">@Fmt.Odds(option.Odds)</b>
                                        </span>
                                    }
                                </div>
                                <div class="bb-muted" style="font-size:0.78rem">
                                    Wettschluss @Fmt.Date(request.ClosesAt)@(request.ClosesAt <= DateTime.UtcNow ? " (abgelaufen)" : "")
                                    · eingereicht @Fmt.Date(request.CreatedAt)
                                    @if (request.ReviewedAt is { } reviewed) { <span> · geprüft @Fmt.Date(reviewed)</span> }
                                </div>
                                @if (request.Status == RequestStatus.Rejected)
                                {
                                    <div class="pa-2" style="border-radius:10px; background:rgba(var(--mud-palette-error-rgb),0.08)">
                                        <b>Begründung:</b> @(string.IsNullOrWhiteSpace(request.AdminNote) ? "keine angegeben" : request.AdminNote)
                                    </div>
                                }
                            </div>
                        }

                        <div class="d-flex flex-wrap gap-1 justify-end" style="width:100%">
                            @if (request.Status == RequestStatus.Approved && request.EventId is { } eventId)
                            {
                                <MudButton Href="@($"events/{eventId}")" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">Zur Wette</MudButton>
                            }
                            @if (request.Status == RequestStatus.Pending)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Disabled="_busy"
                                           OnClick="@(() => Withdraw(request))">Zurückziehen</MudButton>
                            }
                            @if (reusable)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.EditNote"
                                           Disabled="_busy" OnClick="@(() => Reuse(request))">Überarbeiten & neu einreichen</MudButton>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </MudItem>
</MudGrid>

@code {
    private BetDraft _draft = BetDraft.NewYesNo();
    private int _formKey;
    private BetRequest? _basedOn;
    private bool _deadlineCleared;
    private readonly HashSet<Guid> _expanded = [];

    private void ToggleExpanded(Guid id)
    {
        if (!_expanded.Remove(id)) _expanded.Add(id);
    }

    /// <summary>Copies a rejected/withdrawn request into the form as a new, fully editable request.</summary>
    private void Reuse(BetRequest request)
    {
        _draft = BetDraft.From(request);
        _deadlineCleared = request.ClosesAt <= DateTime.UtcNow;
        if (_deadlineCleared) _draft.ClosesDate = null;
        _basedOn = request;
        _copiedFrom = null;
        _formKey++;
        _scrollToForm = true;
    }

    private bool _scrollToForm;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Scroll once the re-created form has been rendered (scrolling earlier gets cut off by the re-render).
        if (!_scrollToForm) return;
        _scrollToForm = false;
        await Js.InvokeVoidAsync("bbScrollToTop");
    }

    private void ResetForm()
    {
        _draft = BetDraft.NewYesNo();
        _basedOn = null;
        _copiedFrom = null;
        _deadlineCleared = false;
        _formKey++;
    }

    /// <summary>Existing bet to copy into the form as a new request (<c>requests?copy={id}</c>).</summary>
    [SupplyParameterFromQuery(Name = "copy")] public Guid? CopyId { get; set; }

    private string? _copiedFrom;
    private Guid? _loadedCopyId;

    protected override async Task OnParametersSetAsync()
    {
        if (CopyId is not { } copyId || copyId == _loadedCopyId) return;
        _loadedCopyId = copyId;
        try
        {
            var source = await Betting.GetEventAsync(copyId);
            if (source is null)
            {
                Snackbar.Add("Die zu kopierende Wette wurde nicht gefunden.", Severity.Warning);
                return;
            }
            _draft = BetDraft.CopyOf(source, out _deadlineCleared);
            _copiedFrom = source.Event.Title;
            _basedOn = null;
            _formKey++;
        }
        catch (Exception ex)
        {
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
    }
    private List<BetRequest>? _requests;
    private bool _busy;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try { _requests = await Betting.GetMyBetRequestsAsync(); }
        catch (Exception ex)
        {
            _requests = [];
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
    }

    private async Task Submit(BetDraft draft)
    {
        _busy = true;
        try
        {
            await Betting.SubmitBetRequestAsync(draft.Title.Trim(), draft.Description, draft.ClosesAtUtc!.Value, draft.ToOptionInputs());
            Snackbar.Add("Danke! Dein Vorschlag wurde eingereicht und wird von einem Admin geprüft.", Severity.Success);
            ResetForm();
            await Load();
        }
        catch (Exception ex)
        {
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Withdraw(BetRequest request)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Vorschlag zurückziehen", $"„{request.Title}“ zurückziehen?",
            yesText: "Zurückziehen", cancelText: "Abbrechen");
        if (confirmed != true) return;
        _busy = true;
        try
        {
            await Betting.WithdrawBetRequestAsync(request.Id);
            await Load();
        }
        catch (Exception ex)
        {
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
