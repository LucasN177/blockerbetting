@page "/profile"
@inject BettingService Betting
@inject ISnackbar Snackbar

<PageTitle>Profil · BlockerBetting</PageTitle>

<PageHeader Title="Profil" Eyebrow="Dein Account" />

@if (Betting.CurrentProfile is { } profile)
{
    <MudGrid Spacing="4">
        <MudItem xs="12" md="5">
            <div class="bb-card bb-card-pad d-flex flex-column align-center" style="text-align:center">
                <Avatar Name="@profile.DisplayName" Size="88" />
                <MudText Typo="Typo.h5" Class="mt-4">@profile.DisplayName</MudText>
                <span class="bb-pill @(profile.IsAdmin ? "bb-tint-primary" : "bb-pill-neutral") mt-2">@(profile.IsAdmin ? "Admin" : "Spieler")</span>
                <div class="bb-muted mt-4" style="font-size:0.8rem">Dabei seit @Fmt.MonthYear(profile.CreatedAt)</div>
                <MudDivider Class="my-5" Style="width:100%" />
                <div class="bb-stat-label">Guthaben</div>
                <Coins Value="profile.Coins" Style="font-size:1.8rem; font-weight:800" />
            </div>
        </MudItem>
        <MudItem xs="12" md="7">
            <div class="bb-card bb-card-pad">
                <div class="bb-section-title">Anzeigename</div>
                <MudText Class="bb-muted mb-4" Typo="Typo.body2">So erscheinst du in der Rangliste.</MudText>
                <form @onsubmit="Save" @onsubmit:preventDefault="true">
                    <MudTextField @bind-Value="_displayName" Label="Anzeigename" MaxLength="40" Variant="Variant.Outlined" Counter="40" Immediate="true" />
                    <div class="d-flex justify-end mt-4">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="@(_busy || string.IsNullOrWhiteSpace(_displayName) || _displayName.Trim() == profile.DisplayName)">
                            Speichern
                        </MudButton>
                    </div>
                </form>
            </div>
            <PushSettings Class="mt-4" />
        </MudItem>
    </MudGrid>
}
else
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Style="border-radius:20px" />
}

@code {
    private string _displayName = "";
    private bool _busy;

    protected override void OnInitialized() => _displayName = Betting.CurrentProfile?.DisplayName ?? "";

    private async Task Save()
    {
        _busy = true;
        try
        {
            await Betting.UpdateDisplayNameAsync(_displayName.Trim());
            Snackbar.Add("Gespeichert.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(BettingService.ErrorMessage(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
