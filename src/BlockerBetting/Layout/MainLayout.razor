@inherits LayoutComponentBase
@implements IDisposable
@inject BettingService Betting
@inject ThemeService ThemeService
@inject NavigationManager Nav

<ThemeRoot />

<MudLayout>
    <MudAppBar Elevation="0" Class="bb-appbar" Fixed="true">
        <MudIconButton Icon="@Icons.Material.Rounded.Menu" Color="Color.Inherit" Edge="Edge.Start" Class="mr-2"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="Menü" />
        <a href="./" class="bb-brand">
            <img src="favicon.svg" alt="" />
            <span class="bb-brand-name d-none d-sm-inline">BlockerBetting</span>
        </a>
        <MudSpacer />
        @if (Betting.CurrentProfile is { } profile)
        {
            <a href="my-bets" class="bb-balance mr-2" title="Dein Guthaben">
                <span class="bb-coin"></span>@Fmt.Coins(profile.Coins)
            </a>
        }
        <MudTooltip Text="@(ThemeService.IsDarkMode ? "Heller Modus" : "Dunkler Modus")">
            <MudIconButton Icon="@(ThemeService.IsDarkMode ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode)"
                           Color="Color.Inherit" OnClick="ThemeService.Toggle" />
        </MudTooltip>
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-1" aria-label="Konto">
            <ActivatorContent>
                <span style="cursor:pointer; display:flex"><Avatar Name="@Betting.CurrentProfile?.DisplayName" Size="36" /></span>
            </ActivatorContent>
            <ChildContent>
                <div class="px-4 pt-3 pb-2" style="min-width:220px">
                    <div style="font-weight:700">@Betting.CurrentProfile?.DisplayName</div>
                    <div class="bb-muted" style="font-size:0.8rem">@(Betting.CurrentProfile?.IsAdmin == true ? "Admin" : "Spieler")</div>
                </div>
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Outlined.Person" Href="profile">Profil</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.ReceiptLong" Href="my-bets">Meine Wetten</MudMenuItem>
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="SignOut">Abmelden</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="@DrawerVariant.Responsive" Class="bb-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="bb-main">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-8 px-4 px-sm-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    protected override void OnInitialized()
    {
        Betting.ProfileChanged += Refresh;
        ThemeService.Changed += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task SignOut()
    {
        await Betting.SignOutAsync();
        Nav.NavigateTo("login");
    }

    public void Dispose()
    {
        Betting.ProfileChanged -= Refresh;
        ThemeService.Changed -= Refresh;
    }
}
