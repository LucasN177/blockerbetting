@implements IDisposable
@inject BettingService Betting

<div class="bb-drawer-content">
    <div class="bb-nav-section" style="padding-top:0.25rem">Spielen</div>
    <MudNavMenu>
        <MudNavLink Href="./" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.SportsScore">Wetten</MudNavLink>
        <MudNavLink Href="my-bets" Icon="@Icons.Material.Rounded.ReceiptLong">Meine Wetten</MudNavLink>
        <MudNavLink Href="requests" Icon="@Icons.Material.Rounded.Lightbulb">Wette vorschlagen</MudNavLink>
        <MudNavLink Href="games" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.Casino">
            <span class="d-flex align-center justify-space-between" style="width:100%">
                Spiele
                <span class="bb-pill bb-tint-primary" style="padding:1px 8px">Beta</span>
            </span>
        </MudNavLink>
        <MudNavLink Href="leaderboard" Icon="@Icons.Material.Rounded.EmojiEvents">Rangliste</MudNavLink>
        <MudNavLink Href="profile" Icon="@Icons.Material.Rounded.Person">Profil</MudNavLink>
    </MudNavMenu>

    @if (Betting.CurrentProfile?.IsAdmin == true)
    {
        <div class="bb-nav-section">Admin</div>
        <MudNavMenu>
            <MudNavLink Href="admin/requests" Icon="@Icons.Material.Rounded.FactCheck">
                <span class="d-flex align-center justify-space-between" style="width:100%">
                    Anfragen
                    @if (_pending > 0)
                    {
                        <span class="bb-pill bb-tint-warning" style="padding:1px 8px">@_pending</span>
                    }
                </span>
            </MudNavLink>
            <MudNavLink Href="admin/bets" Icon="@Icons.Material.Rounded.Tune">Wetten verwalten</MudNavLink>
            <MudNavLink Href="admin/bets/new" Icon="@Icons.Material.Rounded.AddCircleOutline">Neue Wette</MudNavLink>
        </MudNavMenu>
    }

    <footer class="bb-drawer-footer">
        <div style="font-weight:600">v@(AppInfo.Version)</div>
        <div>by @AppInfo.Author</div>
    </footer>
</div>

@code {
    private int _pending;

    protected override async Task OnInitializedAsync()
    {
        Betting.ProfileChanged += OnProfileChanged;
        Betting.RequestsChanged += OnRequestsChanged;
        await LoadPending();
    }

    private async Task LoadPending()
    {
        if (Betting.CurrentProfile?.IsAdmin != true) { _pending = 0; return; }
        try { _pending = await Betting.CountPendingBetRequestsAsync(); }
        catch { /* badge is optional */ }
    }

    private void OnProfileChanged() => InvokeAsync(async () => { await LoadPending(); StateHasChanged(); });

    private void OnRequestsChanged() => InvokeAsync(async () => { await LoadPending(); StateHasChanged(); });

    public void Dispose()
    {
        Betting.ProfileChanged -= OnProfileChanged;
        Betting.RequestsChanged -= OnRequestsChanged;
    }
}
