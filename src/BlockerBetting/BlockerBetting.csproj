<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- App version shown on the loading screen and in the navigation. Bump on releases. -->
    <Version>1.9.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.14.0" />
    <PackageReference Include="Supabase" Version="8.12.0" />
  </ItemGroup>

  <!-- Supabase maps models and sessions via reflection; keep these assemblies untrimmed. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="BlockerBetting" />
    <TrimmerRootAssembly Include="Supabase" />
    <TrimmerRootAssembly Include="Supabase.Core" />
    <TrimmerRootAssembly Include="Supabase.Gotrue" />
    <TrimmerRootAssembly Include="Supabase.Postgrest" />
  </ItemGroup>

  <!-- The repository CHANGELOG.md is the single source; it is embedded into the app and shown under /changelog. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
