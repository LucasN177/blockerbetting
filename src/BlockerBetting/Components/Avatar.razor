<span class="bb-avatar" style="width:@(Size)px;height:@(Size)px;font-size:@(Size * 0.38)px;@Gradient">@Fmt.Initials(Name)</span>

@code {
    [Parameter, EditorRequired] public string? Name { get; set; }
    [Parameter] public int Size { get; set; } = 40;

    private static readonly string[] Gradients =
    [
        "#6366f1,#8b5cf6", "#0ea5e9,#6366f1", "#10b981,#0ea5e9", "#f59e0b,#ef4444",
        "#ec4899,#8b5cf6", "#14b8a6,#22c55e", "#f97316,#f59e0b", "#3b82f6,#06b6d4",
    ];

    // Stable colour per name.
    private string Gradient
    {
        get
        {
            var hash = 0;
            foreach (var c in Name ?? "") hash = unchecked(hash * 31 + c);
            return $"background:linear-gradient(135deg,{Gradients[Math.Abs(hash % Gradients.Length)]});";
        }
    }
}
